# ─────────────────────────────────────────────────────────────────────────────
# .env.cloud.example — settings for the CLOUD pipeline (cloud.main:app)
#
# Copy to .env.cloud and fill in OPENAI_API_KEY:
#     cp .env.cloud.example .env.cloud
#
# The local GPU pipeline (app.main:app) keeps using .env — the two files are
# separate on purpose so the two servers can run side by side with different
# ports and, if you want, different databases.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Deliberately NOT named HOST/PORT: start.sh, start.bat and deploy/entrypoint.sh
# already consume those, and both pipelines may see the same environment.
CLOUD_HOST=0.0.0.0
CLOUD_PORT=8100

# ── Storage & database ───────────────────────────────────────────────────────
# Same names as the local pipeline, so image_path is stored identically.
MEDIA_DIR=media
DATABASE_URL=sqlite:///./card_ocr.db

# Subdirectory under MEDIA_DIR for cloud-pipeline uploads. Keeping them separate
# is what makes the retention sweep safe — it only ever touches this directory,
# never the local pipeline's images in MEDIA_DIR itself.
CLOUD_MEDIA_SUBDIR=cloud

# Delete stored originals older than N days. 0 = keep forever (default).
# Raise this once you know your retention policy; ~0.7MB per card adds up.
CLOUD_IMAGE_RETENTION_DAYS=0

# ── Vision provider ──────────────────────────────────────────────────────────
# REQUIRED. Without it the server still starts and /health answers, but
# /api/cards/upload returns 503.
OPENAI_API_KEY=

# Optional: Azure / gateway / proxy endpoint.
OPENAI_BASE_URL=

CLOUD_VISION_MODEL=gpt-5.6-luna

# Reading a card is perception + literal transcription + label-based bucketing,
# not multi-step reasoning. Reasoning tokens bill at the OUTPUT rate ($1.20/1M)
# and dominate the per-card cost, so `low` is the right default.
#   none | minimal | low | medium | high | xhigh | max
CLOUD_REASONING_EFFORT=low

# Guard against a runaway transcription loop. raw_text + 10 fields needs ~400.
CLOUD_MAX_OUTPUT_TOKENS=4000

CLOUD_OPENAI_TIMEOUT=60
CLOUD_OPENAI_MAX_RETRIES=3

# PRIVACY: false = opt out of provider-side retention. A business card is
# entirely personal data, so not storing it on the provider is the right default.
CLOUD_STORE_RESPONSES=false

# ── Image preprocessing ──────────────────────────────────────────────────────
# Long-edge cap in px. 2048 is sized for phone photos, where the card typically
# fills only 50-70% of the frame — at 2048 a 6pt address line still has ~14px of
# character height. Dropping to 1600 saves only ~18% of the bill; not worth it.
CLOUD_IMAGE_MAX_EDGE=2048
CLOUD_IMAGE_JPEG_QUALITY=88
CLOUD_IMAGE_MAX_BYTES=4194304

#   low | high | auto | original   (we already control resolution above)
CLOUD_IMAGE_DETAIL=auto

# iPhones shoot HEIC by default. Requires pillow-heif; if it is not installed
# the server automatically stops advertising heic/heif regardless of this flag.
CLOUD_ALLOW_HEIC=true

# Phones often upload HEIC labelled application/octet-stream. When true, an
# ambiguous content type is decoded rather than rejected outright.
CLOUD_SNIFF_CONTENT_TYPE=true

# Reject uploads larger than this with 413 (20 MiB).
CLOUD_MAX_UPLOAD_BYTES=20971520

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Repair rounds when the reused regex validator flags a field. Matches
# app/services/card_extractor.py's _MAX_REPAIR. Set 0 for a hard cost ceiling.
CLOUD_MAX_REPAIR=1

# true = return 422 when issues survive repair, instead of saving best-effort.
CLOUD_STRICT_VALIDATION=false
