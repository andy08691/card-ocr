# NOTE: this file configures the LOCAL (MinerU + Ollama) pipeline, app.main:app.
# The cloud pipeline (cloud.main:app, gpt-5.6-luna) is configured separately in
# .env.cloud — see .env.cloud.example and deploy/cloud/README.md.

# Server bind address
# Use 0.0.0.0 to allow access from other processes on the same machine or local network
HOST=0.0.0.0

# Port — change if 8000 is already in use (e.g. PORT=8080)
PORT=8000

# Directory for storing uploaded card images
MEDIA_DIR=media

# SQLite database path
DATABASE_URL=sqlite:///./card_ocr.db

# MinerU OCR backend (optional). Leave empty to auto-detect the accelerator:
#   macOS (mlx-vlm)  -> MLX
#   Linux + vllm     -> vllm (GPU)
#   otherwise        -> transformers (CPU)
# Override with e.g. pipeline / hybrid-engine when you want a specific backend.
MINERU_BACKEND=

# Number of PDF-render worker processes MinerU uses. A business card is a single
# page, so 1 keeps memory low and avoids spawn overhead. (default: 1)
MINERU_PDF_RENDER_THREADS=1

# ── Field extraction (local LLM) ─────────────────────────────────────────────
# Which extractor turns OCR text into the 10 structured card fields:
#   llm   -> candidate(regex) + local Ollama LLM classification + validate/repair (default)
#   regex -> the legacy pure-regex parser (baseline / one-key rollback)
CARD_EXTRACTOR=llm

# Ollama local LLM settings (only used when CARD_EXTRACTOR=llm).
# Model must be pulled first: `ollama pull qwen3:4b`
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434
# How long Ollama keeps the model resident after a request. Longer = subsequent
# uploads stay hot (faster); shorter = frees RAM sooner on 16GB when idle.
OLLAMA_KEEP_ALIVE=30m
